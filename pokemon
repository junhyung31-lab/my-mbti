def pokemon_mbti_quiz():
    print("=== ϞϞ(๑⚈  fontSize ⚈๑) 포켓몬 MBTI 진단 테스트 ===")
    print("질문을 읽고 자신에게 더 가까운 번호를 선택하세요 (1 또는 2)\n")

    scores = {'E': 0, 'I': 0, 'S': 0, 'N': 0, 'T': 0, 'F': 0, 'J': 0, 'P': 0}

    questions = [
        {"q": "1. 휴일에 에너지를 충전하는 방식은?", "a1": ("친구들과 포켓몬 배틀/체육관 순례를 간다", "E"), "a2": ("비밀 기지에서 혼자 쉬거나 책을 읽는다", "I")},
        {"q": "2. 새로운 모험을 시작할 때 중요한 것은?", "a1": ("눈앞에 보이는 현실적인 마을 지도와 도감 정보", "S"), "a2": ("이 모험 끝에 숨겨진 세상의 비밀과 전설", "N")},
        {"q": "3. 동료 포켓몬이 배틀에서 졌을 때 나의 반응은?", "a1": ("어떤 기술 선택이 문제였는지 분석하고 솔루션을 준다", "T"), "a2": ("많이 아팠지? 수고했다고 격려하고 칭찬해 준다", "F")},
        {"q": "4. 포켓몬 리그 도전 계획은?", "a1": ("동선, 체육관 순서, 포켓몬 라인업을 미리 계획한다", "J"), "a2": ("발길 닿는 대로 여행하며 상황에 맞게 도전한다", "P")}
    ]

    for q in questions:
        print(q["q"])
        print(f"  1) {q['a1'][0]}")
        print(f"  2) {q['a2'][0]}")
        
        while True:
            choice = input("선택 (1/2): ").strip()
            if choice == '1':
                scores[q['a1'][1]] += 1
                break
            elif choice == '2':
                scores[q['a2'][1]] += 1
                break
            else:
                print("잘못된 입력입니다. 1 또는 2를 입력해주세요.")
        print()

    # MBTI 조합
    mbti = ""
    mbti += "E" if scores["E"] >= scores["I"] else "I"
    mbti += "S" if scores["S"] >= scores["N"] else "S" if scores["S"] > scores["N"] else "N"
    mbti += "T" if scores["T"] >= scores["F"] else "F"
    mbti += "J" if scores["J"] >= scores["P"] else "P"

    result = POKEMON_MBTI.get(mbti)
    
    print("=" * 45)
    print(f"당신의 MBTI 유형은 [ {mbti} ] 입니다!")
    print(f"당신과 매칭되는 포켓몬: 🌟 {result['pokemon']} 🌟")
    print(f"타이틀: {result['title']}")
    print(f"설명: {result['desc']}")
    print("=" * 45)

if __name__ == "__main__":
    pokemon_mbti_quiz()
